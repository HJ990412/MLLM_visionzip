+def validate_full_load_contract(runner, ctx, *, prompt_text=None,
+                                question=None, cache_id=None, suffix_ids=None):
+    """Fail closed on mismatched fixed-prefix cache inputs before any I/O.
+
+    A suffix-only caller explicitly accepts the prefix supplied by ``ctx``;
+    it cannot assert the contents of text it did not supply. A full prompt
+    caller must match the stored pre-image IDs exactly. The context itself is
+    the cache identity unless a separate request cache_id is supplied.
+    """
+    meta = ctx.meta
+    if cache_id is not None and str(cache_id) != str(meta.get("image_id")):
+        raise ValueError("FullLoad request cache_id does not match image cache")
+    if ctx.cache.meta != meta or ctx.reader.meta != meta:
+        raise ValueError("FullLoad context/cache metadata mismatch")
+    if prompt_text is not None and question is not None:
+        raise ValueError("provide question or prompt_text, not both")
+    prompt = prompt_text if prompt_text is not None else (
+        runner.prompt(question) if question is not None else None)
+    if prompt is None:
+        return "explicit_suffix_with_context_owned_prefix"
+    ids = runner.processor.tokenizer(prompt, return_tensors="pt").input_ids[0]
+    locations = (ids == runner.image_token_id).nonzero(as_tuple=True)[0]
+    if locations.numel() != 1:
+        raise ValueError("FullLoad fixed-prefix cache requires one image")
+    start = int(locations[0])
+    source = [int(x) for x in meta["prefix_input_ids"]]
+    if (start != int(meta["v_token_start"])
+            or ids[:start].tolist() != source[:start]
+            or source[start:] != [runner.image_token_id] * int(meta["v_token_num"])):
+        raise ValueError("FullLoad request prefix does not match cached prefix")
+    if suffix_ids is not None:
+        supplied = torch.as_tensor(suffix_ids).detach().cpu()
+        if supplied.ndim != 1 or not torch.equal(supplied, ids[start + 1:].cpu()):
+            raise ValueError("FullLoad supplied suffix does not match full prompt")
+    return "full_prompt_prefix_and_optional_cache_id_verified"
+
+
