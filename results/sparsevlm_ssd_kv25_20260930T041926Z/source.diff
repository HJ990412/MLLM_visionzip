+                              'same_prompt_same_raters', row['request_id'])
+    result = check.result()
+    result.update(scope='complete_provided_cohorts_only', rows=len(rows), independently_rescored=score_count,
+                  completed_cohorts=len(supplied_groups), final_pilot_valid=False)
+    return result
