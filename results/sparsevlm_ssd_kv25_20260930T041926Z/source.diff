+        _finite(value, name)
+    raters = _ids(rater_rows, suffix_len, "rater rows")
+    if not raters:
+        raise ValueError("empty raters: callers must use explicit rater fallback")
+    vn, pn = visual_key.shape[1], system_key.shape[1]
