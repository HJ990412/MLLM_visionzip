+    if len(receipt.get('samples',[]))!=10 or receipt.get('MT_generated_history',{}).get('status')!='PASS':raise RuntimeError('BLOCKED: GPU fixed-sample/MT evidence incomplete')
+    return {'path':str(path),'sha256':V.sha(path),'verdict':'PASS'}
