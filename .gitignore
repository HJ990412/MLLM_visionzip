# Generated KV stores and downloaded benchmark data
/kvstore*/
/data/*
!/data/index.json

# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Local secrets and editor files
.env
.env.*
!.env.example
.DS_Store
.vscode/
.idea/
*.swp

# Generated logs and model/binary artifacts
/*.log
*.pt
*.bin
*.safetensors
*.ckpt


# Large local experiment artifacts (publish compressed MT-GQA raw instead)
/results/mt_gqa_full/raw.jsonl
/runs/image_only_generalization/*/images/
/runs/mt_gqa_full/*/images/

# Large/duplicated artifacts from the ConvBench and query-aware baselines.
# Keep the curated results/ reports and compressed raw evidence instead.
/runs/convbench_context/
/runs/convbench_context_quality/
/runs/convbench_full/
/runs/convbench_judge/
/runs/convbench_native_probe/
/runs/query_aware_baseline/
/runs/query_aware_chunk_baseline/
/runs/mt_gqa_4arm_history_comparison_*/
/results/query_aware_baseline/gqa40_240/
/results/query_aware_baseline/gqa40_240_final/selection.json
/results/query_aware_baseline/gqa40_240_final/summary.json
/results/query_aware_baseline/gqa40_240_final/validation.json
/results/query_aware_chunk_baseline/smoke_5_*/
/results/query_aware_chunk_baseline/*/results_final.jsonl
/results/convbench_full/generation_577/raw.jsonl
/results/mt_gqa_4arm_history_comparison_*/gold_history/raw.jsonl
/results/mt_gqa_4arm_history_comparison_*/generated_history/raw.jsonl

# Baseline run directories contain generated KV stores and duplicate logs.
/runs/mpic_baseline/
/runs/rekv_baseline/
/runs/mt_vqa_v2_generated_4arm_*/

# Validated request logs and large protection manifests are published as gzip.
/results/mpic_baseline/*/raw.jsonl
/results/mpic_baseline/*/protected_artifacts_before.json
/results/rekv_baseline/*/raw.jsonl
/results/rekv_baseline/*/protected_artifacts_before.json
/results/mt_vqa_v2_generated_4arm_*/raw.jsonl

# Five-arm generated-history run payloads stay local; publish validated results.
/runs/mt_gqa_5arm_generated_*/
/results/mt_gqa_5arm_generated_*/raw.jsonl
/results/mt_gqa_5arm_generated_*/protected_artifacts_before.json
/results/mt_gqa_5arm_generated_*/raw.jsonl.gz.part-*
/results/mt_gqa_5arm_generated_*/protected_artifacts_before.json.gz

# KV25/Qwen run-local stores and raw request logs stay local; publish reports.
/runs/llava_kv25_migration_*/
/runs/qwen25_*/
/results/llava_kv25_migration_*/gqa_raw.jsonl
/results/llava_kv25_migration_*/mt_smoke_raw.jsonl

# New AllHead/selector/persistence run roots are large; curated result files
# are deliberately force-added from their generated result directories.
/runs/llava_contextual_kv25_*/
/runs/llava_spatial_kv25_*/
/runs/sparsevlm_ssd_kv25_*/
/runs/llava_mt_gqa_allhead_kv25_main_*/
/runs/qwen_mt_gqa_kv25_main_*/
/runs/prefix25_persistence_*/
/results/llava_contextual_kv25_*/
/results/llava_spatial_kv25_*/
/results/sparsevlm_ssd_kv25_*/
/results/llava_mt_gqa_allhead_kv25_main_*/
/results/qwen_mt_gqa_kv25_main_*/
/results/prefix25_persistence_*/
